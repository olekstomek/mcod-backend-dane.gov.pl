server {
    listen       80;
    server_name  _;
    return       404;
}

server {
  listen 443 ssl;
  listen [::]:443 ssl;
  server_name mcod.local;
  charset utf-8;
  client_max_body_size 500M;
  access_log /var/log/nginx/access.log;
  error_log /var/log/nginx/error.log;
  ssl_certificate ${MCOD_CERTS_PATH}/mcod.local.crt;
  ssl_certificate_key ${MCOD_CERTS_PATH}/mcod.local.key;

  location / {
    proxy_pass ${MCOD_NGINX_FRONTEND};
    proxy_pass_header Server;
    proxy_set_header Host $host;
    proxy_set_header X-Scheme https;
    proxy_set_header X-Url-Scheme https;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Host $server_name;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
  }

  location ~* /sitemap.+\.xml\.gz$ {
      root /usr/share/nginx/html/sitemap;
      if (-f $document_root/.maintenance) {
            return 503;
      }
      try_files /latest/$uri =404;
      add_header Content-Type application/xml;
      add_header Content-Encoding gzip;
      }

  location ~ .(ws|ws/)$ {
    proxy_pass ${MCOD_NGINX_WS};

    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";

    proxy_redirect off;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Host $server_name;
  }

  location /static/xml {
    alias /usr/share/nginx/html/xml;
  }

  location /static {
    alias /usr/share/nginx/html/statics;
  }

  location /media/showcases/ {
    alias /usr/share/nginx/html/media/showcases/;
    add_header Content-Disposition 'attachment' always;
    add_header Content-Security-Policy "default-src 'none'; script-src 'none'; sandbox" always;
    add_header X-Content-Type-Options nosniff always;
  }

  # Meeting files must be authorized and forced as downloads by Django
  # instead of being rendered directly from public /media.
  location /media/meetings/ {
    proxy_pass ${MCOD_NGINX_ADMIN};
    proxy_pass_header Server;
    proxy_set_header Host $host;
    proxy_set_header X-Scheme https;
    proxy_set_header X-Url-Scheme https;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Host $server_name;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
  }

  location /media {
    alias /usr/share/nginx/html/media;
  }

  location /pn-apps {
    proxy_pass ${MCOD_NGINX_PN_APPS};
    proxy_pass_header Server;
    proxy_set_header Host $host;

    proxy_set_header X-Scheme https;
    proxy_set_header X-Url-Scheme https;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Host $server_name;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
  }

}

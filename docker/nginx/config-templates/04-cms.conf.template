server {
  listen 443 ssl;
  listen [::]:443 ssl;
  server_name cms.mcod.local;
  charset utf-8;
  client_max_body_size 1300M;
  client_body_buffer_size 1300M;
  client_body_timeout 360s;
  access_log /var/log/nginx/access.log;
  error_log /var/log/nginx/error.log;
  root /usr/share/nginx/html;
  ssl_certificate /etc/nginx/conf.d/certs/mcod.local.crt;
  ssl_certificate_key /etc/nginx/conf.d/certs/mcod.local.key;

  location /static {
    alias /usr/share/nginx/html/statics;
    add_header 'Access-Control-Allow-Origin' '*' always;
  }

  location /media/showcases/ {
    alias /usr/share/nginx/html/media/showcases/;
    add_header 'Access-Control-Allow-Origin' '*' always;
    add_header Content-Disposition 'attachment' always;
    add_header Content-Security-Policy "default-src 'none'; script-src 'none'; sandbox" always;
    add_header X-Content-Type-Options nosniff always;
  }

  location /media {
    alias /usr/share/nginx/html/media;
    add_header 'Access-Control-Allow-Origin' '*' always;
  }

  # redirect to /admin on bare host
  rewrite ^/$ https://$host/admin/ redirect;

  location / {
    proxy_pass ${MCOD_NGINX_CMS};
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Scheme $scheme;
    proxy_set_header X-Url-Scheme $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Host $server_name;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout       3600s;
    proxy_send_timeout          3600s;
    proxy_read_timeout          3600s;

    add_header 'Access-Control-Allow-Headers' 'DNT,Authorization,User-Agent,X-Requested-With,X-Api-Version,If-Modified-Since,Cache-Control,Content-Type,Range,Expires,Pragma' always;
    add_header 'Access-Control-Allow-Methods' 'GET, POST, PUT, PATCH, DELETE, OPTIONS' always;
    add_header 'Access-Control-Allow-Origin' 'http://mcod.local' always;
    add_header 'Access-Control-Allow-Credentials' 'true' always;

    if ($request_method = 'OPTIONS') {
      add_header 'Access-Control-Allow-Headers' 'DNT,Authorization,User-Agent,X-Requested-With,X-Api-Version,If-Modified-Since,Cache-Control,Content-Type,Range,Expires,Pragma' always;
      add_header 'Access-Control-Allow-Methods' 'GET, POST, PUT, PATCH, DELETE, OPTIONS' always;
      add_header 'Access-Control-Allow-Origin' 'http://mcod.local' always;
      add_header 'Access-Control-Allow-Credentials' 'true' always;
      add_header 'Access-Control-Max-Age' 1728000;
      add_header 'Content-Type' 'text/plain; charset=utf-8';
      return 204;
    }
  }
}
